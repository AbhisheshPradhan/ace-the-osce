# Copy to .env.local for local development, and set the same values in Vercel
# (Project → Settings → Environment Variables).

# Contact form (https://resend.com → API Keys). Required for the form to send.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL="Ace the OSCE website <noreply@acetheosce.com.au>"

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code (only the content value).
# Not needed if the domain is verified by DNS instead.
GOOGLE_SITE_VERIFICATION=
